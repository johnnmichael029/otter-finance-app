# ─────────────────────────────────────────────────────────────────────────────
#  OTTER Finance App — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/otter?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
