{
  "expo": {
    "name": "OTTER",
    "slug": "otter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otter.finance"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E91E8C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.otter.finance",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E91E8C",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "OTTER Finance"
        }
      ],
      "expo-camera",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/withAndroidWidget"
    ],
    "extra": {
      "eas": {
        "projectId": "59a1de66-41ad-4342-b959-b672b5cddd96"
      }
    },
    "owner": "yamashiis-organization"
  }
}
